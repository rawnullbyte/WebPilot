{
  "manifest_version": 3,
  "name": "WebPilot",
  "version": "1.0.0",
  "description": "Drive any web page with your own OpenAI-compatible model. WebPilot reads the page — including iframes — then clicks, types, scrolls and navigates for you.",

  "browser_specific_settings": {
    "gecko": {
      "id": "webpilot@webpilot.local",
      "strict_min_version": "120.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },

  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webNavigation"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "scripts": ["src/background/background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": ["src/content/page.js"]
    }
  ],

  "action": {
    "default_title": "WebPilot",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png"
    }
  },

  "sidebar_action": {
    "default_title": "WebPilot",
    "default_panel": "src/sidebar/sidebar.html",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png"
    }
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "96": "src/icons/icon-96.png",
    "128": "src/icons/icon-128.png"
  }
}