{
  "name": "webpilot",
  "version": "1.0.0",
  "private": true,
  "description": "Firefox extension that drives web pages with your own OpenAI-compatible model.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "icons": "python3 scripts/make_icons.py",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/check.mjs",
    "start": "npm run build && node scripts/run.mjs",
    "zip": "npm run build && node scripts/zip.mjs",
    "test": "node test/page.test.mjs && node test/llm.test.mjs && node test/bridge.test.mjs && node test/background.test.mjs",
    "snapshot": "node test/snapshot.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && node scripts/check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.474.0",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
